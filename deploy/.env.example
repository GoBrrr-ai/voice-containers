# Voice-api token + image overrides (cp .env.example .env)
# Bearer auth on the voice-api HTTP servers; unset = open (private networks).
# /health is always exempt. The wyoming pair ignores it (HA-native TCP).
VOICE_API_TOKEN=

# --- service image overrides (defaults = Orin Nano Option A, CPU pair) ---
STT_IMAGE=narandill/parakeet-redux-stt:0.1.0
STT_DEVICE=cpu
TTS_IMAGE=narandill/phonon31m-tts:0.1.0
LLM_IMAGE=narandill/llama-cpp:0.8.0
LLM_MODEL=Qwen3-4B-Instruct-2507-Q4_K_M.gguf
LLM_CTX=8192

# --- host ports ---
STT_PORT=8080
TTS_PORT=8880
LLM_PORT=8088
WYOMING_STT_PORT=10300
WYOMING_TTS_PORT=10200

# --- model volumes (ro mounts) ---
STT_MODEL_DIR=./models
LLM_MODEL_DIR=./models
