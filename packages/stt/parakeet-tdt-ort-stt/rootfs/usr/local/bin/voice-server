#!/usr/bin/env python3
"""voice-api v1 STT server — NVIDIA Parakeet TDT 0.6B v3 int4 (plain ONNX) (in-memory; no temp files).

POST /v1/audio/transcriptions  multipart ('file' required) or raw WAV body
GET  /v1/voices | /v1/models | /health     — docs/voice-api.md

Adapter core from bench/engines/client.py (ParakeetTdtOrt).
"""
import email
import io
import json
import os
import threading
import wave
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

import numpy as np

ENGINE = "parakeet_tdt_ort"           # adapter name (client.py registry)
VERSION = "0.1.0"
PORT = int(os.environ.get("PORT", "8080"))
DEVICE = os.environ.get("DEVICE", "cuda")
MODEL_ID = os.environ.get("MODEL_ID", "parakeet-tdt-0.6b-v3-int4")
LANGUAGES = ['en']
REQUIRE_16K = True

import onnxruntime as ort

_MODEL_DIR = os.environ.get("TDT_ORT_MODEL_DIR", "/models/parakeet-int4")
_ENC_PROVIDERS = (
    ["CUDAExecutionProvider", "CPUExecutionProvider"]
    if DEVICE == "cuda"
    else ["CPUExecutionProvider"]
)
_so = ort.SessionOptions()
_so.log_severity_level = 3
_FEAT = ort.InferenceSession(
    os.path.join(_MODEL_DIR, "nemo128.onnx"), _so, providers=["CPUExecutionProvider"]
)
_ENC = ort.InferenceSession(
    os.path.join(_MODEL_DIR, "encoder-model.int4.onnx"), _so, providers=_ENC_PROVIDERS
)
_DEC = ort.InferenceSession(
    os.path.join(_MODEL_DIR, "decoder_joint-model.int8.onnx"),
    _so,
    providers=["CPUExecutionProvider"],
)
if (
    DEVICE == "cuda"
    and _ENC.get_providers()[0] != "CUDAExecutionProvider"
):
    raise RuntimeError("CUDA EP not active on the int4 encoder")
_DEVICE_ACTUAL = "cuda" if _ENC.get_providers()[0] == "CUDAExecutionProvider" else "cpu"

_BLANK_ID = 8192
_VOCAB_SIZE = 8193
_DURATIONS = [0, 1, 2, 3, 4]
_MAX_TOKENS_PER_STEP = 10
_VOCAB = {}
with open(os.path.join(_MODEL_DIR, "vocab.txt"), encoding="utf-8") as _f:
    for _line in _f:
        _line = _line.rstrip("\n")
        if _line:
            _tok, _idx = _line.rsplit(" ", 1)
            _VOCAB[int(_idx)] = _tok


def _engine_transcribe(sr, pcm):
    import re as _re

    if sr != 16000:
        raise ValueError("this engine requires 16 kHz mono input")
    raw = np.frombuffer(pcm, np.int16)
    wave = np.concatenate(
        [raw.astype(np.float32) / 32768.0, np.zeros(16000, dtype=np.float32)]
    )
    w = wave[None, :]
    wl = np.array([w.shape[1]], dtype=np.int64)
    features, features_lens = _FEAT.run(
        ["features", "features_lens"], {"waveforms": w, "waveforms_lens": wl}
    )
    enc, enc_lens = _ENC.run(
        ["outputs", "encoded_lengths"],
        {"audio_signal": features, "length": features_lens},
    )
    enc_t = enc.transpose(0, 2, 1)
    T = int(enc_lens[0])
    state1 = np.zeros((2, 1, 640), dtype=np.float32)
    state2 = np.zeros((2, 1, 640), dtype=np.float32)
    tokens = []
    t = 0
    emitted = 0
    while t < T:
        frame = enc_t[0, t][None, :, None]
        outputs, _, s1, s2 = _DEC.run(
            ["outputs", "prednet_lengths", "output_states_1", "output_states_2"],
            {
                "encoder_outputs": frame,
                "targets": np.array(
                    [[tokens[-1] if tokens else _BLANK_ID]], dtype=np.int32
                ),
                "target_length": np.array([1], dtype=np.int32),
                "input_states_1": state1,
                "input_states_2": state2,
            },
        )
        logits = np.squeeze(outputs)
        token = int(logits[:_VOCAB_SIZE].argmax())
        step = _DURATIONS[int(logits[_VOCAB_SIZE:].argmax())]
        if token != _BLANK_ID:
            state1, state2 = s1, s2
            tokens.append(token)
        if step > 0:
            t += step
            emitted = 0
        elif token == _BLANK_ID or emitted == _MAX_TOKENS_PER_STEP:
            t += 1
            emitted = 0
    text = "".join(_VOCAB[i].replace("\u2581", " ") for i in tokens)
    return _re.sub(r"\s+", " ", text).strip()

_LOCK = threading.Lock()


def _decode_wav(body):
    with wave.open(io.BytesIO(body), "rb") as w:
        sr, sw, ch = w.getframerate(), w.getsampwidth(), w.getnchannels()
        pcm = w.readframes(w.getnframes())
    if sw != 2 or ch != 1:
        raise ValueError(f"expected 16-bit mono WAV, got {sw * 8}-bit x{ch}")
    return sr, pcm


def _multipart(body, ct):
    msg = email.message_from_bytes(b"Content-Type: " + ct.encode() + b"\r\n\r\n" + body)
    fields, files = {}, {}
    for part in msg.walk():
        name = part.get_param("name", header="content-disposition")
        if not name:
            continue
        payload = part.get_payload(decode=True) or b""
        if part.get_filename():
            files[name] = payload
        else:
            fields[name] = payload.decode("utf-8", "replace")
    return fields, files


def _voices_payload():
    return {
        "object": "list",
        "data": [
            {
                "id": MODEL_ID,
                "object": "voice",
                "task": "stt",
                "sample_rate": 16000,
                "languages": LANGUAGES,
                "streaming": False,
                "engine": ENGINE,
                "version": VERSION,
            }
        ],
    }


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def _json(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _fail(self, code, msg):
        self._json(code, {"error": {"message": msg, "type": "invalid_request_error"}})

    def do_GET(self):
        p = self.path.split("?")[0]
        if p == "/health":
            self._json(
                200,
                {"status": "ok", "engine": ENGINE, "version": VERSION,
                 "device": _DEVICE_ACTUAL, "model": MODEL_ID},
            )
        elif p in ("/v1/voices", "/v1/models"):
            self._json(200, _voices_payload())
        else:
            self._json(404, {"error": {"message": "not found"}})

    def do_POST(self):
        if self.path.split("?")[0] != "/v1/audio/transcriptions":
            self._json(404, {"error": {"message": "not found"}})
            return
        length = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(length)
        ct = self.headers.get("Content-Type", "")
        fmt, model = "json", self.headers.get("X-Model")
        if "multipart/form-data" in ct:
            fields, files = _multipart(body, ct)
            wav = files.get("file")
            if wav is None:
                self._fail(400, "missing required field 'file'")
                return
            model = fields.get("model") or model
            fmt = fields.get("response_format") or "json"
        else:
            wav = body  # raw WAV body fallback
        if fmt not in ("json", "text", "verbose_json"):
            self._fail(400, "response_format must be json, text or verbose_json")
            return
        if model and model != MODEL_ID:
            self._fail(400, f"unknown model {model!r}; supported: ['{MODEL_ID}']")
            return
        try:
            sr, pcm = _decode_wav(wav)
        except ValueError as e:
            self._fail(400, str(e))
            return
        try:
            with _LOCK:
                text = _engine_transcribe(sr, pcm)
        except ValueError as e:
            self._fail(400, str(e))
            return
        except Exception as e:
            self._json(500, {"error": {"message": repr(e)[:300]}})
            return
        if fmt == "text":
            payload = text.encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)
        elif fmt == "verbose_json":
            self._json(200, {"task": "transcribe", "text": text,
                             "duration": len(pcm) / 2 / sr})
        else:
            self._json(200, {"text": text})


if __name__ == "__main__":
    ThreadingHTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
