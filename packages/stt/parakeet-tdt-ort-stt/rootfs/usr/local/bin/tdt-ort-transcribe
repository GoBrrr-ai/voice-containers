#!/opt/venv/bin/python3
"""parakeet-tdt-0.6b-v3 int4 ONNX on onnxruntime — TDT greedy decode.

Usage: tdt-ort-transcribe <wav> [-o out.txt] [--provider cuda|cpu]

Pipeline: 16 kHz float32 [-1,1) -> nemo128 featurizer (CPU) -> int4
MatMulNBits encoder (CUDA EP; CPU fallback fine) -> TDT greedy decode with
the dynamic-int8 decoder_joint (CPU EP — DynamicQuantizeLSTM/MatMulInteger
have no CUDA kernels). Loop ported from NeMo GreedyTDTInfer and verified
end-to-end against jfk.flac (task/research/parakeet-int4-ort-driver/).
"""
import argparse
import os
import re
import sys

import numpy as np

BLANK_ID = 8192  # <blk> — last line of vocab.txt (8193 tokens, ids 0..8192)
VOCAB_SIZE = 8193  # token logits = outputs[..., :8193]; durations = [..., 8193:]
DURATIONS = [0, 1, 2, 3, 4]  # duration argmax index == frames to skip
MAX_TOKENS_PER_STEP = 10
SUBSAMPLING = 8  # encoder frames per mel block; 1 enc frame = 8*160 = 1280 samples


def load_sessions(model_dir: str, provider: str):
    import onnxruntime as ort

    so = ort.SessionOptions()
    so.log_severity_level = 3
    enc_prov = (
        ["CUDAExecutionProvider", "CPUExecutionProvider"]
        if provider == "cuda"
        else ["CPUExecutionProvider"]
    )
    sess = {
        "featurizer": ort.InferenceSession(
            os.path.join(model_dir, "nemo128.onnx"), so, providers=["CPUExecutionProvider"]
        ),
        "encoder": ort.InferenceSession(
            os.path.join(model_dir, "encoder-model.int4.onnx"), so, providers=enc_prov
        ),
        # dynamic-int8 QOperator: no CUDA kernels — keep on CPU by design
        "decoder": ort.InferenceSession(
            os.path.join(model_dir, "decoder_joint-model.int8.onnx"),
            so,
            providers=["CPUExecutionProvider"],
        ),
    }
    if provider == "cuda" and sess["encoder"].get_providers()[0] != "CUDAExecutionProvider":
        print("WARNING: CUDA EP not active on the encoder (CPU fallback)", file=sys.stderr)
    return sess


def transcribe_pcm(sess: dict, vocab: dict, pcm_i16: np.ndarray) -> str:
    wave = pcm_i16.astype(np.float32) / 32768.0
    wave = np.concatenate([wave, np.zeros(16000, dtype=np.float32)])  # 1 s tail (NeMo)
    w = wave[None, :]
    wl = np.array([w.shape[1]], dtype=np.int64)

    features, features_lens = sess["featurizer"].run(
        ["features", "features_lens"], {"waveforms": w, "waveforms_lens": wl}
    )
    enc, enc_lens = sess["encoder"].run(
        ["outputs", "encoded_lengths"],
        {"audio_signal": features, "length": features_lens},
    )
    enc_t = enc.transpose(0, 2, 1)  # [1, T', 1024]
    T = int(enc_lens[0])

    state1 = np.zeros((2, 1, 640), dtype=np.float32)
    state2 = np.zeros((2, 1, 640), dtype=np.float32)
    tokens = []
    t = 0
    emitted = 0
    while t < T:
        frame = enc_t[0, t][None, :, None]  # [1, 1024, 1]
        outputs, _, s1, s2 = sess["decoder"].run(
            ["outputs", "prednet_lengths", "output_states_1", "output_states_2"],
            {
                "encoder_outputs": frame,
                "targets": np.array([[tokens[-1] if tokens else BLANK_ID]], dtype=np.int32),
                "target_length": np.array([1], dtype=np.int32),
                "input_states_1": state1,
                "input_states_2": state2,
            },
        )
        logits = np.squeeze(outputs)  # [8198]
        token = int(logits[:VOCAB_SIZE].argmax())
        step = DURATIONS[int(logits[VOCAB_SIZE:].argmax())]

        if token != BLANK_ID:
            state1, state2 = s1, s2  # LSTM state advances only on emitted tokens
            tokens.append(token)

        if step > 0:
            t += step
            emitted = 0
        elif token == BLANK_ID or emitted == MAX_TOKENS_PER_STEP:
            t += 1
            emitted = 0

    text = "".join(vocab[i].replace("\u2581", " ") for i in tokens)
    return re.sub(r"\s+", " ", text).strip()


def main() -> None:
    ap = argparse.ArgumentParser(description="parakeet-tdt-0.6b-v3 int4 STT (plain ORT)")
    ap.add_argument("wav")
    ap.add_argument("-o", "--out", default="")
    ap.add_argument("--provider", default=os.environ.get("TDT_ORT_PROVIDER", "cuda"))
    args = ap.parse_args()

    model_dir = os.environ.get("TDT_ORT_MODEL_DIR", "/models/parakeet-int4")
    sess = load_sessions(model_dir, args.provider)

    vocab = {}
    with open(os.path.join(model_dir, "vocab.txt"), encoding="utf-8") as f:
        for line in f:
            line = line.rstrip("\n")
            if line:
                tok, idx = line.rsplit(" ", 1)
                vocab[int(idx)] = tok

    import wave

    with wave.open(args.wav, "rb") as w:
        assert w.getframerate() == 16000 and w.getnchannels() == 1, "expect 16 kHz mono"
        pcm = np.frombuffer(w.readframes(w.getnframes()), np.int16)

    text = transcribe_pcm(sess, vocab, pcm)
    if args.out:
        with open(args.out, "w") as f:
            f.write(text + "\n")
    else:
        print(text)


if __name__ == "__main__":
    main()
