#!/opt/venv/bin/python3
"""Nemotron Speech Streaming EN 0.6B — streaming transcription.

Usage: nemotron-stream-transcribe <wav> [-o out.txt]

Canonical feed: the whole utterance + 0.2 s tail padding; the graph does
its own cache-aware chunking per the baked 160 ms latency profile (never
pre-chunk the audio yourself — wrong boundaries silently drop audio).
For a live source, feed audio as it arrives and decode whenever
recognizer.is_ready(stream) — same pipeline, no manual chunking.
"""
import argparse
import os

import numpy as np
import sherpa_onnx
import soundfile as sf


def main() -> None:
    ap = argparse.ArgumentParser(description="Nemotron Speech Streaming EN 0.6B STT (int8)")
    ap.add_argument("wav")
    ap.add_argument("-o", "--out", default="")
    args = ap.parse_args()

    recognizer = sherpa_onnx.OnlineRecognizer.from_transducer(
        encoder=os.environ["NEMOSTREAM_ENCODER"],
        decoder=os.environ["NEMOSTREAM_DECODER"],
        joiner=os.environ["NEMOSTREAM_JOINER"],
        tokens=os.environ["NEMOSTREAM_VOCAB"],
        num_threads=1,
        provider=os.environ.get("NEMOTRON_STREAM_PROVIDER", "cpu"),
    )
    pcm, sr = sf.read(args.wav, dtype="float32")
    if pcm.ndim > 1:
        pcm = pcm.mean(axis=1)
    if sr != 16000:
        import soxr

        pcm = soxr.resample(pcm, sr, 16000)
        sr = 16000

    stream = recognizer.create_stream()
    stream.accept_waveform(sr, pcm)
    stream.accept_waveform(sr, np.zeros(int(0.2 * sr), dtype=np.float32))
    stream.input_finished()
    while recognizer.is_ready(stream):
        recognizer.decode_stream(stream)

    result = recognizer.get_result(stream)
    text = (result if isinstance(result, str) else result.text).strip()
    print(text)
    if args.out:
        with open(args.out, "w") as f:
            f.write(text + "\n")


if __name__ == "__main__":
    main()
