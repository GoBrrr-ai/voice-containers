#!/opt/venv/bin/python3
"""Canary-180M-Flash transcription (offline, per utterance).

Usage: canary-transcribe <wav> [--src en] [--tgt en] [-o out.txt]

VAD-chunk long audio upstream (see README) — the model transcribes one
utterance at a time; en/de/es/fr with X->EN translation via --tgt en.
"""
import argparse
import os

import sherpa_onnx
import soundfile as sf


def main() -> None:
    ap = argparse.ArgumentParser(description="Canary-180M-Flash STT (int8, sherpa-onnx)")
    ap.add_argument("wav")
    ap.add_argument("--src", default=os.environ.get("CANARY_SRC_LANG", "en"))
    ap.add_argument("--tgt", default=os.environ.get("CANARY_TGT_LANG", "en"))
    ap.add_argument("-o", "--out", default="")
    args = ap.parse_args()

    recognizer = sherpa_onnx.OfflineRecognizer.from_nemo_canary(
        encoder=os.environ["CANARY_ENCODER"],
        decoder=os.environ["CANARY_DECODER"],
        tokens=os.environ["CANARY_VOCAB"],
        num_threads=1,
        provider=os.environ.get("CANARY_PROVIDER", "cpu"),
        src_lang=args.src,
        tgt_lang=args.tgt,
    )
    pcm, sr = sf.read(args.wav, dtype="float32")
    if pcm.ndim > 1:
        pcm = pcm.mean(axis=1)

    stream = recognizer.create_stream()
    stream.accept_waveform(sr, pcm)
    recognizer.decode_stream(stream)
    text = stream.result.text.strip()
    print(text)
    if args.out:
        with open(args.out, "w") as f:
            f.write(text + "\n")


if __name__ == "__main__":
    main()
