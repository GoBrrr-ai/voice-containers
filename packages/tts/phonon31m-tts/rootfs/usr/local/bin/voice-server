#!/opt/venv/bin/python3
"""voice-api v1 TTS server — phonon-31m (true frame streaming; no temp files).

POST /v1/audio/speech  JSON {input, voice?, model?, response_format?, speed?}
GET  /v1/voices | /v1/models | /health
GET  /say?text=...   — legacy phonon31m endpoint, kept for compat
GET  /health         — legacy alias

Adapter core from bench/engines/client.py (Ptts). CPU by design.
"""
import io
import json
import os
import threading
import urllib.parse
import wave
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

import numpy as np

ENGINE = "ptts"
VERSION = "0.1.0"
PORT = int(os.environ.get("TTS_PORT", "8880"))
DEVICE = "cpu"  # phonon-31m is CPU-only by design
MODEL = os.environ.get("PTTS_MODEL", "/models/phonon-31m-en")
LANG = os.environ.get("PTTS_LANG", "en")
QUANT = os.environ.get("PTTS_QUANT", "q8")
VOICES = ["default"]
SAMPLE_RATE = 24000

from ptts import TTS  # noqa: E402

_TTS = None
_TTS_LOCK = threading.Lock()


def get_tts():
    global _TTS
    with _TTS_LOCK:
        if _TTS is None:
            _TTS = TTS(MODEL, lang=LANG, quant=QUANT)
        return _TTS


def _int16(audio):
    a = np.asarray(audio, dtype=np.float32)
    return (np.clip(a, -1.0, 1.0) * 32767).astype(np.int16)


def _wav_bytes(audio, sr):
    buf = io.BytesIO()
    with wave.open(buf, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(int(sr))
        w.writeframes(_int16(audio).tobytes())
    return buf.getvalue()


def _wav_header(n_frames, rate):
    buf = bytearray()
    buf += b"RIFF"
    buf += (36 + n_frames * 2).to_bytes(4, "little")
    buf += b"WAVE" + b"fmt " + (16).to_bytes(4, "little")
    buf += (1).to_bytes(2, "little")  # PCM
    buf += (1).to_bytes(2, "little")  # mono
    buf += rate.to_bytes(4, "little")
    buf += (rate * 2).to_bytes(4, "little")
    buf += (2).to_bytes(2, "little")
    buf += (16).to_bytes(2, "little")
    buf += b"data" + (n_frames * 2).to_bytes(4, "little")
    return bytes(buf)


def _voices_payload():
    return {
        "object": "list",
        "data": [
            {
                "id": v,
                "object": "voice",
                "task": "tts",
                "sample_rate": SAMPLE_RATE,
                "languages": [LANG],
                "streaming": True,
                "speed": False,
                "cloning": False,
                "engine": ENGINE,
                "version": VERSION,
            }
            for v in VOICES
        ],
    }


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def _json(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _start_chunked(self, sr):
        self.send_response(200)
        self.send_header("Content-Type", "application/octet-stream")
        self.send_header("X-Sample-Rate", str(int(sr)))
        self.send_header("Transfer-Encoding", "chunked")
        self.end_headers()

    def _write_chunk(self, data):
        self.wfile.write(f"{len(data):x}\r\n".encode() + data + b"\r\n")

    def _end_chunked(self):
        self.wfile.write(b"0\r\n\r\n")

    def do_GET(self):
        u = urllib.parse.urlparse(self.path)
        qs = urllib.parse.parse_qs(u.query)
        if u.path == "/health":
            self._json(
                200,
                {"status": "ok", "engine": ENGINE, "version": VERSION,
                 "device": DEVICE, "voices": VOICES},
            )
        elif u.path in ("/v1/voices", "/v1/models"):
            self._json(200, _voices_payload())
        elif u.path == "/say":
            # legacy: streamed WAV (header + frames as generated), chunked
            text = (qs.get("text", [""])[0]).strip()
            if not text:
                self._json(400, {"error": {"message": "'text' is required"}})
                return
            self.send_response(200)
            self.send_header("Content-Type", "audio/wav")
            self.send_header("Transfer-Encoding", "chunked")
            self.end_headers()
            with _TTS_LOCK:
                with get_tts().stream(text) as audio:
                    self._write_chunk(_wav_header(0, audio.sample_rate))
                    for pcm in audio:
                        self._write_chunk(_int16(pcm).tobytes())
            self._end_chunked()
        else:
            self._json(404, {"error": {"message": "not found"}})

    def do_POST(self):
        p = self.path.split("?")[0]
        if p != "/v1/audio/speech":
            self._json(404, {"error": {"message": "not found"}})
            return
        try:
            length = int(self.headers.get("Content-Length", 0))
            req = json.loads(self.rfile.read(length) or b"{}")
        except Exception:
            self._json(400, {"error": {"message": "invalid JSON body"}})
            return
        text = (req.get("input") or "").strip()
        if not text:
            self._json(400, {"error": {"message": "'input' is required"}})
            return
        voice = req.get("voice") or VOICES[0]
        if voice not in VOICES:
            self._json(
                400,
                {"error": {"message": f"unknown voice {voice!r}; supported: {VOICES}"}},
            )
            return
        model = req.get("model")
        if model and model != ENGINE:
            self._json(
                400,
                {"error": {"message": f"unknown model {model!r}; supported: ['{ENGINE}']"}},
            )
            return
        fmt = req.get("response_format", "wav")
        if fmt not in ("wav", "pcm"):
            self._json(
                400,
                {"error": {"message": "response_format must be 'wav' or 'pcm'"}},
            )
            return
        if req.get("speed"):
            pass  # phonon-31m has no speed knob — politely ignored
        try:
            with _TTS_LOCK:
                with get_tts().stream(text) as audio:
                    sr = audio.sample_rate
                    if fmt == "pcm":
                        self._start_chunked(sr)
                        for pcm in audio:
                            self._write_chunk(_int16(pcm).tobytes())
                        self._end_chunked()
                    else:
                        chunks = [_int16(pcm) for pcm in audio]
                        body = _wav_bytes(np.concatenate(chunks), sr)
                        self.send_response(200)
                        self.send_header("Content-Type", "audio/wav")
                        self.send_header("X-Sample-Rate", str(int(sr)))
                        self.send_header("Content-Length", str(len(body)))
                        self.end_headers()
                        self.wfile.write(body)
        except Exception as e:
            self._json(500, {"error": {"message": repr(e)[:300]}})


if __name__ == "__main__":
    ThreadingHTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
