#!/opt/venv/bin/python3
"""voice-api v1 TTS server — pocket-tts (in-memory; no temp files).

POST /v1/audio/speech  JSON {input, voice?, model?, response_format?}
GET  /v1/voices | /v1/models | /health     — docs/voice-api.md

Adapter core from bench/engines/client.py (PocketTts). Voice cloning stays
on the official `pocket-tts serve` (POST /tts with voice_wav) — this server
validates against the 8 built-in voices only. No speed knob upstream.
"""
import io
import json
import os
import threading
import wave
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

import numpy as np

ENGINE = "pocket_tts"
VERSION = "0.3.0"
PORT = int(os.environ.get("PORT", "8000"))
DEVICE = os.environ.get("DEVICE", "cuda")
LANGUAGE = os.environ.get("POCKET_LANGUAGE", "english")
VOICES = [
    "alba", "marius", "javert", "jean",
    "fantine", "cosette", "eponine", "azelma",
]

from pocket_tts import TTSModel  # noqa: E402

_M = TTSModel.load_model(language=LANGUAGE)
if DEVICE != "cpu":
    _M.to(DEVICE)
SAMPLE_RATE = int(_M.config.mimi.sample_rate)
_LOCK = threading.Lock()


def _state(voice):
    return _M.get_state_for_audio_prompt(voice)


def _int16(audio):
    if hasattr(audio, "detach"):  # torch tensor, possibly on cuda:0
        audio = audio.detach().cpu()
    a = np.asarray(audio, dtype=np.float32)
    if a.ndim > 1:
        a = a.reshape(-1)
    return (np.clip(a, -1.0, 1.0) * 32767).astype(np.int16)


def _wav_bytes(pcm_bytes, sr):
    buf = io.BytesIO()
    with wave.open(buf, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(int(sr))
        w.writeframes(pcm_bytes)
    return buf.getvalue()


def _voices_payload():
    return {
        "object": "list",
        "data": [
            {
                "id": v,
                "object": "voice",
                "task": "tts",
                "sample_rate": SAMPLE_RATE,
                "languages": ["en"],
                "streaming": True,
                "speed": False,
                "cloning": True,  # via the official serve (voice_wav upload)
                "engine": ENGINE,
                "version": VERSION,
            }
            for v in VOICES
        ],
    }


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def _json(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        p = self.path.split("?")[0]
        if p == "/health":
            self._json(
                200,
                {"status": "ok", "engine": ENGINE, "version": VERSION,
                 "device": DEVICE, "language": LANGUAGE, "voices": VOICES},
            )
        elif p in ("/v1/voices", "/v1/models"):
            self._json(200, _voices_payload())
        else:
            self._json(404, {"error": {"message": "not found"}})

    def do_POST(self):
        if self.path.split("?")[0] != "/v1/audio/speech":
            self._json(404, {"error": {"message": "not found"}})
            return
        try:
            length = int(self.headers.get("Content-Length", 0))
            req = json.loads(self.rfile.read(length) or b"{}")
        except Exception:
            self._json(400, {"error": {"message": "invalid JSON body"}})
            return
        text = (req.get("input") or "").strip()
        if not text:
            self._json(400, {"error": {"message": "'input' is required"}})
            return
        voice = req.get("voice") or VOICES[0]
        if voice not in VOICES:
            self._json(
                400,
                {"error": {"message": f"unknown voice {voice!r}; supported: {VOICES}"}},
            )
            return
        model = req.get("model")
        if model and model != ENGINE:
            self._json(
                400,
                {"error": {"message": f"unknown model {model!r}; supported: ['{ENGINE}']"}},
            )
            return
        fmt = req.get("response_format", "wav")
        if fmt not in ("wav", "pcm"):
            self._json(
                400,
                {"error": {"message": "response_format must be 'wav' or 'pcm'"}},
            )
            return
        try:
            with _LOCK:
                if fmt == "pcm":
                    # chunked transfer: chunks stream as generated
                    self.send_response(200)
                    self.send_header("Content-Type", "application/octet-stream")
                    self.send_header("X-Sample-Rate", str(SAMPLE_RATE))
                    self.send_header("Transfer-Encoding", "chunked")
                    self.end_headers()
                    for t in _M.generate_audio_stream(
                        model_state=_state(voice), text_to_generate=text
                    ):
                        self._write_chunk(_int16(t).tobytes())
                    self.wfile.write(b"0\r\n\r\n")
                else:
                    pcm = bytearray()
                    for t in _M.generate_audio_stream(
                        model_state=_state(voice), text_to_generate=text
                    ):
                        pcm += _int16(t).tobytes()
                    body = _wav_bytes(bytes(pcm), SAMPLE_RATE)
                    self.send_response(200)
                    self.send_header("Content-Type", "audio/wav")
                    self.send_header("X-Sample-Rate", str(SAMPLE_RATE))
                    self.send_header("Content-Length", str(len(body)))
                    self.end_headers()
                    self.wfile.write(body)
        except Exception as e:
            self._json(500, {"error": {"message": repr(e)[:300]}})

    def _write_chunk(self, data):
        self.wfile.write(f"{len(data):x}\r\n".encode() + data + b"\r\n")


if __name__ == "__main__":
    ThreadingHTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
