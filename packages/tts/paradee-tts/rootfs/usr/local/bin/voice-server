#!/opt/venv/bin/python3
"""voice-api v1 TTS server — paradee (in-memory; no temp files).

POST /v1/audio/speech  JSON {input, voice?, model?, response_format?, speed?}
GET  /v1/voices | /v1/models | /health     — docs/voice-api.md

Adapter core from bench/engines/client.py (Paradee) — incl. the CUDA-EP
session patch (the package hardcodes CPU providers in its constructor).
Single-chunk engine: pcm responses arrive as one chunk (still valid
chunked transfer); TTFA == synthesis completion.
"""
import io
import json
import os
import signal
import threading
import wave
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

import numpy as np
import onnxruntime as ort

ENGINE = "paradee"
VERSION = "0.2.0"
PORT = int(os.environ.get("PORT", "8880"))
DEVICE = os.environ.get("DEVICE", "cuda")
MODEL_VERSION = os.environ.get("PARADEE_MODEL_VERSION", "1.2")
VOICES = ["af_heart", "bf_isabella", "am_puck", "bm_fable"]
SAMPLE_RATE = 24000


def _sync_cuda():
    try:
        import ctypes
        import ctypes.util

        rt_ = getattr(_sync_cuda, "_rt", None)
        if rt_ is None:
            name = ctypes.util.find_library("cudart") or "libcudart.so.13"
            rt_ = _sync_cuda._rt = ctypes.CDLL(name)
        if rt_.cudaDeviceSynchronize() == 0:
            return
    except Exception:
        pass


from paradee import Paradee  # noqa: E402

if DEVICE == "cuda":
    # the package hardcodes providers=["CPUExecutionProvider"] — intercept
    # session construction in its own module so GPU images use the CUDA EP
    import sys

    _mod = sys.modules[Paradee.__module__]
    _real = _mod.ort.InferenceSession

    def _with_cuda(model_path, so=None, providers=None):
        return _real(
            model_path,
            so,
            providers=["CUDAExecutionProvider", "CPUExecutionProvider"],
        )

    _mod.ort.InferenceSession = _with_cuda
    try:
        _TTS = Paradee(version=MODEL_VERSION, quantized=True)
    finally:
        _mod.ort.InferenceSession = _real
else:
    _TTS = Paradee(version=MODEL_VERSION, quantized=True)

try:
    _ACTUAL = "cuda" if "CUDA" in _TTS.session.get_providers()[0] else "cpu"
except Exception:
    _ACTUAL = "cuda" if DEVICE == "cuda" else "cpu"
_LOCK = threading.Lock()


def _synth(text, voice, speed):
    audio = _TTS(text, speed=speed, voice=voice)
    _sync_cuda()
    return np.asarray(audio), SAMPLE_RATE


def _int16(audio):
    a = np.asarray(audio, dtype=np.float32)
    return (np.clip(a, -1.0, 1.0) * 32767).astype(np.int16)


def _wav_bytes(audio, sr):
    buf = io.BytesIO()
    with wave.open(buf, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(int(sr))
        w.writeframes(_int16(audio).tobytes())
    return buf.getvalue()


def _voices_payload():
    return {
        "object": "list",
        "data": [
            {
                "id": v,
                "object": "voice",
                "task": "tts",
                "sample_rate": SAMPLE_RATE,
                "languages": ["en-us"],
                "streaming": False,
                "speed": True,
                "cloning": False,
                "engine": ENGINE,
                "version": VERSION,
            }
            for v in VOICES
        ],
    }


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def _json(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _auth_ok(self):
        """Optional bearer-token gate (VOICE_API_TOKEN); unset = open."""
        tok = os.environ.get("VOICE_API_TOKEN")
        if not tok:
            return True
        return self.headers.get("Authorization", "") == f"Bearer {tok}"

    def do_GET(self):
        # /health is exempt: orchestrator healthchecks cannot send the token
        if self.path.split("?")[0] != "/health" and not self._auth_ok():
            self._json(
                401,
                {"error": {"message": "invalid or missing bearer token", "type": "authentication_error"}},
            )
            return
        p = self.path.split("?")[0]
        if p == "/health":
            self._json(
                200,
                {"status": "ok", "engine": ENGINE, "version": VERSION,
                 "device": _ACTUAL, "voices": VOICES},
            )
        elif p in ("/v1/voices", "/v1/models"):
            self._json(200, _voices_payload())
        else:
            self._json(404, {"error": {"message": "not found"}})

    def do_POST(self):
        # /health is exempt: orchestrator healthchecks cannot send the token
        if self.path.split("?")[0] != "/health" and not self._auth_ok():
            self._json(
                401,
                {"error": {"message": "invalid or missing bearer token", "type": "authentication_error"}},
            )
            return
        if self.path.split("?")[0] != "/v1/audio/speech":
            self._json(404, {"error": {"message": "not found"}})
            return
        try:
            length = int(self.headers.get("Content-Length", 0))
            req = json.loads(self.rfile.read(length) or b"{}")
        except Exception:
            self._json(400, {"error": {"message": "invalid JSON body"}})
            return
        text = (req.get("input") or "").strip()
        if not text:
            self._json(400, {"error": {"message": "'input' is required"}})
            return
        voice = req.get("voice") or VOICES[0]
        if voice not in VOICES:
            self._json(
                400,
                {"error": {"message": f"unknown voice {voice!r}; supported: {VOICES}"}},
            )
            return
        model = req.get("model")
        if model and model != ENGINE:
            self._json(
                400,
                {"error": {"message": f"unknown model {model!r}; supported: ['{ENGINE}']"}},
            )
            return
        fmt = req.get("response_format", "wav")
        if fmt not in ("wav", "pcm"):
            self._json(
                400,
                {"error": {"message": "response_format must be 'wav' or 'pcm'"}},
            )
            return
        speed = float(req.get("speed", 1.0) or 1.0)
        speed = min(max(speed, 0.25), 4.0)
        try:
            with _LOCK:
                audio, sr = _synth(text, voice, speed)
            data = _int16(audio).tobytes()
            self.send_response(200)
            self.send_header("X-Sample-Rate", str(int(sr)))
            if fmt == "wav":
                body = _wav_bytes(audio, sr)
                self.send_header("Content-Type", "audio/wav")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
            else:
                # single-chunk engine: one chunked-transfer write
                self.send_header("Content-Type", "application/octet-stream")
                self.send_header("Transfer-Encoding", "chunked")
                self.end_headers()
                self.wfile.write(f"{len(data):x}\r\n".encode() + data + b"\r\n")
                self.wfile.write(b"0\r\n\r\n")
        except Exception as e:
            self._json(500, {"error": {"message": repr(e)[:300]}})


def _serve():
    """serve_forever with SIGTERM/SIGINT -> clean shutdown (fast docker stop)."""
    srv = ThreadingHTTPServer(("0.0.0.0", PORT), Handler)

    def _stop(*_a):
        threading.Thread(target=srv.shutdown, daemon=True).start()

    signal.signal(signal.SIGTERM, _stop)
    signal.signal(signal.SIGINT, _stop)
    srv.serve_forever()


if __name__ == "__main__":
    _serve()
