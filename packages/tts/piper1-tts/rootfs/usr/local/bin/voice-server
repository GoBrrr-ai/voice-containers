#!/opt/venv/bin/python3
"""voice-api v1 TTS server — piper1-tts (in-memory; no temp files).

POST /v1/audio/speech  JSON {input, voice?, model?, response_format?, speed?}
  response_format=pcm streams the synthesis generator's chunks as they come
  (one chunk per sentence) via chunked transfer — audio starts flowing before
  the last sentence is synthesized. wav assembles the same chunks in memory.
GET  /v1/voices | /v1/models | /health     — docs/voice-api.md

Adapter core from bench/engines/client.py (PiperTts): PiperVoice.load on the
baked voice, CUDA when PIPER_USE_CUDA — plus the per-sentence generator the
serving layer streams (client.py wraps it back into a single wav).
"""

import io
import json
import os
import signal
import threading
import wave
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

import numpy as np
from piper import PiperVoice
from piper.config import SynthesisConfig

ENGINE = "piper"  # adapter name (client.py registry)
VERSION = "0.2.0"
PORT = int(os.environ.get("PIPER_PORT", "8091"))
VOICE = os.environ.get("PIPER_VOICE", "en_US-libritts_r-medium")
CACHE = os.environ.get("PIPER_CACHE", "/data/models/piper")
USE_CUDA = os.environ.get("PIPER_USE_CUDA", "true") == "true"
LENGTH_SCALE = os.environ.get("PIPER_LENGTH_SCALE") or None
NOISE_SCALE = os.environ.get("PIPER_NOISE_SCALE") or None
NOISE_W = os.environ.get("PIPER_NOISE_W") or None
SPEAKER = os.environ.get("PIPER_SPEAKER") or None

_model_path = os.path.join(CACHE, f"{VOICE}.onnx")
_voice = PiperVoice.load(_model_path, use_cuda=USE_CUDA)
SAMPLE_RATE = int(_voice.config.sample_rate)
VOICES = [VOICE]
_DEVICE_ACTUAL = "cuda" if USE_CUDA else "cpu"

_LOCK = threading.Lock()


def _float_or_none(v):
    return float(v) if v is not None else None


def _synth_config(speed):
    """Per-request config; None fields defer to the voice's own JSON values.
    OpenAI `speed` maps to piper's length scale (1 = native rate)."""
    length_scale = _float_or_none(LENGTH_SCALE)
    if speed is not None and speed != 1.0:
        length_scale = length_scale / speed if length_scale else 1.0 / speed
    return SynthesisConfig(
        speaker_id=int(SPEAKER) if SPEAKER else None,
        length_scale=length_scale,
        noise_scale=_float_or_none(NOISE_SCALE),
        noise_w_scale=_float_or_none(NOISE_W),
    )


def _synth_stream(text, speed):
    """Yield (int16 pcm bytes, rate) per sentence chunk."""
    for chunk in _voice.synthesize(text, syn_config=_synth_config(speed)):
        pcm = np.clip(chunk.audio_float_array, -1.0, 1.0)
        yield (pcm * 32767).astype(np.int16).tobytes(), int(chunk.sample_rate)


def _int16(audio):
    a = np.asarray(audio, dtype=np.float32)
    return (np.clip(a, -1.0, 1.0) * 32767).astype(np.int16)


def _wav_bytes(chunks, sr):
    buf = io.BytesIO()
    with wave.open(buf, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(sr)
        for b in chunks:
            w.writeframes(b)
    return buf.getvalue()


def _voices_payload():
    return {
        "object": "list",
        "data": [
            {
                "id": v,
                "object": "voice",
                "task": "tts",
                "sample_rate": SAMPLE_RATE,
                "languages": ["en"],
                "streaming": True,
                "speed": True,
                "cloning": False,
                "engine": ENGINE,
                "version": VERSION,
            }
            for v in VOICES
        ],
    }


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def _json(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _auth_ok(self):
        """Optional bearer-token gate (VOICE_API_TOKEN); unset = open."""
        tok = os.environ.get("VOICE_API_TOKEN")
        if not tok:
            return True
        return self.headers.get("Authorization", "") == f"Bearer {tok}"

    def do_GET(self):
        # /health is exempt: orchestrator healthchecks cannot send the token
        if self.path.split("?")[0] != "/health" and not self._auth_ok():
            self._json(
                401,
                {
                    "error": {
                        "message": "invalid or missing bearer token",
                        "type": "authentication_error",
                    }
                },
            )
            return
        p = self.path.split("?")[0]
        if p == "/health":
            self._json(
                200,
                {
                    "status": "ok",
                    "engine": ENGINE,
                    "version": VERSION,
                    "device": _DEVICE_ACTUAL,
                    "voices": VOICES,
                },
            )
        elif p in ("/v1/voices", "/v1/models"):
            self._json(200, _voices_payload())
        else:
            self._json(404, {"error": {"message": "not found"}})

    def do_POST(self):
        # /health is exempt: orchestrator healthchecks cannot send the token
        if self.path.split("?")[0] != "/health" and not self._auth_ok():
            self._json(
                401,
                {
                    "error": {
                        "message": "invalid or missing bearer token",
                        "type": "authentication_error",
                    }
                },
            )
            return
        if self.path.split("?")[0] != "/v1/audio/speech":
            self._json(404, {"error": {"message": "not found"}})
            return
        try:
            length = int(self.headers.get("Content-Length", 0))
            req = json.loads(self.rfile.read(length) or b"{}")
        except Exception:
            self._json(400, {"error": {"message": "invalid JSON body"}})
            return
        text = (req.get("input") or "").strip()
        if not text:
            self._json(400, {"error": {"message": "'input' is required"}})
            return
        voice = req.get("voice") or VOICES[0]
        if voice not in VOICES:
            self._json(
                400,
                {"error": {"message": f"unknown voice {voice!r}; supported: {VOICES}"}},
            )
            return
        model = req.get("model")
        if model and model != ENGINE:
            self._json(
                400,
                {
                    "error": {
                        "message": f"unknown model {model!r}; supported: ['{ENGINE}']"
                    }
                },
            )
            return
        fmt = req.get("response_format", "wav")
        if fmt not in ("wav", "pcm"):
            self._json(
                400,
                {"error": {"message": "response_format must be 'wav' or 'pcm'"}},
            )
            return
        speed = float(req.get("speed", 1.0) or 1.0)
        speed = min(max(speed, 0.25), 4.0)
        try:
            with _LOCK:
                if fmt == "pcm":
                    # chunked transfer: audio flows per sentence, before the
                    # last one is synthesized; rate declared in the header
                    chunks = _synth_stream(text, speed)
                    first = next(chunks, None)
                    if first is None:
                        self._json(200, {"error": {"message": "empty audio"}})
                        return
                    self.send_response(200)
                    self.send_header("Content-Type", "application/octet-stream")
                    self.send_header("X-Sample-Rate", str(first[1]))
                    self.send_header("Transfer-Encoding", "chunked")
                    self.end_headers()
                    self._write_chunk(first[0])
                    for data, _sr in chunks:
                        self._write_chunk(data)
                    self.wfile.write(b"0\r\n\r\n")
                else:
                    buf, sr = [], None
                    for data, rate in _synth_stream(text, speed):
                        buf.append(data)
                        sr = rate
                    body = _wav_bytes(buf, sr)
                    self.send_response(200)
                    self.send_header("Content-Type", "audio/wav")
                    self.send_header("X-Sample-Rate", str(sr))
                    self.send_header("Content-Length", str(len(body)))
                    self.end_headers()
                    self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            raise  # client walked away mid-stream — nothing to answer with
        except Exception as e:
            self._json(500, {"error": {"message": repr(e)[:300]}})

    def _write_chunk(self, data):
        if not data:
            return
        self.wfile.write(f"{len(data):x}\r\n".encode() + data + b"\r\n")


def _serve():
    """serve_forever with SIGTERM/SIGINT -> clean shutdown (fast docker stop)."""
    srv = ThreadingHTTPServer(("0.0.0.0", PORT), Handler)

    def _stop(*_a):
        threading.Thread(target=srv.shutdown, daemon=True).start()

    signal.signal(signal.SIGTERM, _stop)
    signal.signal(signal.SIGINT, _stop)
    srv.serve_forever()


if __name__ == "__main__":
    _serve()
