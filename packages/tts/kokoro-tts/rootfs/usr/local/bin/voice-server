#!/opt/venv/bin/python3
"""voice-api v1 TTS server — kokoro (in-memory; no temp files).

POST /v1/audio/speech  JSON {input, voice?, model?, response_format?, speed?}
GET  /v1/voices | /v1/models | /health     — docs/voice-api.md

Adapter core from bench/engines/client.py (Kokoro), incl. the pauses guard.
"""
import asyncio
import io
import json
import os
import threading
import wave
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

import numpy as np
import onnxruntime as rt
from kokoro_onnx import Kokoro

ENGINE = "kokoro"
VERSION = "0.2.0"
PORT = int(os.environ.get("PORT", "8880"))
DEVICE = os.environ.get("DEVICE", "cuda")
MODEL_PATH = os.environ.get("KOKORO_MODEL", "/opt/kokoro/model_uint8.onnx")
VOICES_PATH = os.environ.get("KOKORO_VOICES", "/opt/kokoro/voices-v1.0.bin")
LANG = os.environ.get("KOKORO_LANG", "en-us")
VOICES = ["af_heart", "af_bella", "bf_isabella", "am_puck", "bm_fable"]
SAMPLE_RATE = 24000

# kokoro-onnx 0.6.1 pauses.py crashes on sub-frame chunks ("zero-size array
# to reduction operation maximum") — guard it exactly like the bench adapter.
import kokoro_onnx.pauses as _pauses

_orig_quiet = _pauses._quiet_frames


def _quiet_frames_guarded(audio, frame):
    if len(audio) < frame:
        return np.zeros(0, dtype=np.bool_)
    return _orig_quiet(audio, frame)


_pauses._quiet_frames = _quiet_frames_guarded


def _sync_cuda():
    try:
        import ctypes
        import ctypes.util

        rt_ = getattr(_sync_cuda, "_rt", None)
        if rt_ is None:
            name = ctypes.util.find_library("cudart") or "libcudart.so.13"
            rt_ = _sync_cuda._rt = ctypes.CDLL(name)
        if rt_.cudaDeviceSynchronize() == 0:
            return
    except Exception:
        pass


_providers = (
    ["CUDAExecutionProvider", "CPUExecutionProvider"]
    if DEVICE == "cuda"
    else ["CPUExecutionProvider"]
)
_sess = rt.InferenceSession(MODEL_PATH, providers=_providers)
_K = Kokoro.from_session(_sess, VOICES_PATH)
_ACTUAL = "cuda" if _sess.get_providers()[0] == "CUDAExecutionProvider" else "cpu"
_LOCK = threading.Lock()


def _synth(text, voice, speed):
    audio, sr = _K.create(text, voice=voice, lang=LANG, speed=speed)
    _sync_cuda()
    return np.asarray(audio), sr


def _synth_stream(text, voice, speed):
    """Drive kokoro's async generator incrementally so TTFA stays real."""
    it = _K.create_stream(text, voice=voice, lang=LANG, speed=speed)
    loop = asyncio.new_event_loop()
    try:
        while True:
            try:
                samples, sr = loop.run_until_complete(it.__anext__())
            except StopAsyncIteration:
                break
            _sync_cuda()
            yield np.asarray(samples), sr
    finally:
        loop.run_until_complete(it.aclose())
        loop.close()


def _int16(audio):
    a = np.asarray(audio, dtype=np.float32)
    return (np.clip(a, -1.0, 1.0) * 32767).astype(np.int16)


def _wav_bytes(audio, sr):
    buf = io.BytesIO()
    with wave.open(buf, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(int(sr))
        w.writeframes(_int16(audio).tobytes())
    return buf.getvalue()


def _voices_payload():
    return {
        "object": "list",
        "data": [
            {
                "id": v,
                "object": "voice",
                "task": "tts",
                "sample_rate": SAMPLE_RATE,
                "languages": [LANG],
                "streaming": True,
                "speed": True,
                "cloning": False,
                "engine": ENGINE,
                "version": VERSION,
            }
            for v in VOICES
        ],
    }


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def _json(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _chunked(self, chunks, sr):
        self.send_response(200)
        self.send_header("Content-Type", "application/octet-stream")
        self.send_header("X-Sample-Rate", str(int(sr)))
        self.send_header("Transfer-Encoding", "chunked")
        self.end_headers()
        for b in chunks:
            if not b:
                continue
            self.wfile.write(f"{len(b):x}\r\n".encode() + b + b"\r\n")
        self.wfile.write(b"0\r\n\r\n")

    def do_GET(self):
        p = self.path.split("?")[0]
        if p == "/health":
            self._json(
                200,
                {"status": "ok", "engine": ENGINE, "version": VERSION,
                 "device": _ACTUAL, "voices": VOICES},
            )
        elif p in ("/v1/voices", "/v1/models"):
            self._json(200, _voices_payload())
        else:
            self._json(404, {"error": {"message": "not found"}})

    def do_POST(self):
        if self.path.split("?")[0] != "/v1/audio/speech":
            self._json(404, {"error": {"message": "not found"}})
            return
        try:
            length = int(self.headers.get("Content-Length", 0))
            req = json.loads(self.rfile.read(length) or b"{}")
        except Exception:
            self._json(400, {"error": {"message": "invalid JSON body"}})
            return
        text = (req.get("input") or "").strip()
        if not text:
            self._json(400, {"error": {"message": "'input' is required"}})
            return
        voice = req.get("voice") or VOICES[0]
        if voice not in VOICES:
            self._json(
                400,
                {"error": {"message": f"unknown voice {voice!r}; supported: {VOICES}"}},
            )
            return
        model = req.get("model")
        if model and model != ENGINE:
            self._json(
                400,
                {"error": {"message": f"unknown model {model!r}; supported: ['{ENGINE}']"}},
            )
            return
        fmt = req.get("response_format", "wav")
        if fmt not in ("wav", "pcm"):
            self._json(
                400,
                {"error": {"message": "response_format must be 'wav' or 'pcm'"}},
            )
            return
        speed = float(req.get("speed", 1.0) or 1.0)
        speed = min(max(speed, 0.25), 4.0)
        try:
            with _LOCK:
                if fmt == "pcm":
                    # chunked transfer: audio starts playing before synthesis
                    # ends (TTFA = first clause); rate declared in the header
                    chunks = _synth_stream(text, voice, speed)
                    first = next(chunks, None)
                    if first is None:
                        self._json(200, {"error": {"message": "empty audio"}})
                        return
                    self.send_response(200)
                    self.send_header("Content-Type", "application/octet-stream")
                    self.send_header("X-Sample-Rate", str(int(first[1])))
                    self.send_header("Transfer-Encoding", "chunked")
                    self.end_headers()
                    self._write_chunk(_int16(first[0]).tobytes())
                    for samples, _sr in chunks:
                        self._write_chunk(_int16(samples).tobytes())
                    self.wfile.write(b"0\r\n\r\n")
                else:
                    audio, sr = _synth(text, voice, speed)
                    body = _wav_bytes(audio, sr)
                    self.send_response(200)
                    self.send_header("Content-Type", "audio/wav")
                    self.send_header("X-Sample-Rate", str(int(sr)))
                    self.send_header("Content-Length", str(len(body)))
                    self.end_headers()
                    self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            raise  # client walked away mid-stream — nothing to answer with
        except Exception as e:
            self._json(500, {"error": {"message": repr(e)[:300]}})

    def _write_chunk(self, data):
        self.wfile.write(f"{len(data):x}\r\n".encode() + data + b"\r\n")


if __name__ == "__main__":
    ThreadingHTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
