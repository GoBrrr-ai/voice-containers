#!/opt/venv/bin/python3
"""Sentence-chunked streaming for Paradee (the graph synthesizes whole
utterances, so we chunk at sentence boundaries and emit WAV chunks as they
are generated). Usage: paradee-stream "long text..." [-o out.wav] [--voice V]

Emits per-chunk timing so you can pipe frames to a player as they arrive.
"""
import argparse, os, re, sys, time, wave

import numpy as np
from paradee import Paradee, SAMPLE_RATE


def sentences(text: str) -> list[str]:
    parts = re.split(r"(?<=[.!?;:])\s+", text.strip())
    return [p for p in parts if p] or [text]


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("text")
    ap.add_argument("-o", "--out", default="paradee_stream.wav")
    ap.add_argument("--voice", default="af_heart")
    a = ap.parse_args()
    tts = Paradee(version=os.environ.get("PARADEE_MODEL_VERSION", "1.0"), quantized=True)
    t0 = time.perf_counter()
    w = wave.open(a.out, "wb")
    w.setnchannels(1); w.setsampwidth(2); w.setframerate(SAMPLE_RATE)
    n = 0
    for i, s in enumerate(sentences(a.text)):
        audio = tts(s, voice=a.voice)
        if i == 0:
            print(f"TTFA (first sentence): {(time.perf_counter() - t0) * 1000:.0f} ms", file=sys.stderr)
        pcm = (np.clip(audio, -1, 1) * 32767).astype("<i2")
        w.writeframes(pcm.tobytes())
        n += len(audio)
    w.close()
    print(f"paradee stream: {n / SAMPLE_RATE:.1f}s -> {a.out}")


if __name__ == "__main__":
    main()
