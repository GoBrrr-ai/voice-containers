{
  "python": "3.14.6",
  "platform": "Linux-6.8.12-tegra-aarch64-with-glibc2.39",
  "machine": "aarch64",
  "hostname": "jetsonthor",
  "nvidia_smi": "NVIDIA Thor, 11.0, 580.00",
  "cuda_version": "release 13.0",
  "jetpack_l4t": "# R38 (release), REVISION: 4.0, GCID: 43443517, BOARD: generic, EABI: aarch64, DATE: Wed Dec 31 00:15:19 UTC 2025",
  "nvpmodel": "NV Power Mode: MAXN\n0",
  "jetson_clocks": "SOC family:tegra264  Machine:NVIDIA Jetson AGX Thor Developer Kit\nError: Run this script(/bin/jetson_clocks) as a root user",
  "tegrastats_available": true,
  "git_commit": "cc5be46",
  "utc_ts": "2026-11-04T02:41:29Z",
  "compute_cap": "11.0",
  "compute_cap_ok": true,
  "power_profile": "default",
  "device_label": "jetson-agx-thor-128gb",
  "config": {
    "run_name": "thor_tts_baseline",
    "task": "tts",
    "device_label": "jetson-agx-thor-128gb",
    "power_profile": "default",
    "dataset": {
      "name": "librispeech",
      "split": "test-clean",
      "language": "en",
      "manifest": "manifests/tts_librispeech_test-clean_en_444_seed42.jsonl",
      "n": 500,
      "seed": 42
    },
    "normalizer": "whisper_english",
    "cache_dir": "datasets/cache",
    "engines": [
      {
        "name": "kokoro",
        "image": "narandill/kokoro-tts:0.1.0",
        "backends": [
          "cuda"
        ],
        "serve": {
          "port": 8880,
          "transport": "openai"
        },
        "opts": {
          "model": "/opt/kokoro/model_uint8.onnx",
          "voices": "/opt/kokoro/voices-v1.0.bin",
          "voice": "af_heart"
        }
      },
      {
        "name": "ptts",
        "image": "narandill/phonon31m-tts:0.1.0",
        "backends": [
          "cpu"
        ],
        "serve": {
          "port": 8880,
          "transport": "openai"
        },
        "opts": {
          "model": "/models/phonon-31m-en",
          "lang": "en",
          "quant": "q8_0"
        }
      },
      {
        "name": "paradee",
        "image": "narandill/paradee-tts:0.2.0",
        "backends": [
          "cuda",
          "cpu"
        ],
        "serve": {
          "port": 8880,
          "transport": "openai",
          "env": {
            "DEVICE": "{backend}"
          }
        },
        "opts": {
          "version": "1.2",
          "quantized": true
        }
      },
      {
        "name": "piper",
        "image": "narandill/wyoming-piper1-tts:0.1.0",
        "backends": [
          "cuda"
        ],
        "serve": {
          "port": 10200,
          "transport": "wyoming"
        },
        "opts": {
          "voice": "en_US-libritts_r-medium"
        }
      },
      {
        "name": "pocket_tts",
        "image": "narandill/pocket-tts:0.3.0",
        "backends": [
          "cpu"
        ],
        "serve": {
          "port": 8000,
          "transport": "openai",
          "env": {
            "DEVICE": "cpu"
          }
        },
        "opts": {
          "language": "english",
          "voice": "alba"
        }
      },
      {
        "name": "pocket_tts",
        "image": "narandill/pocket-tts:0.3.0",
        "backends": [
          "cuda"
        ],
        "serve": {
          "port": 8000,
          "transport": "openai"
        },
        "opts": {
          "language": "english",
          "voice": "alba",
          "device": "cuda"
        }
      }
    ],
    "streaming": {
      "chunk_ms": 160,
      "realtime_pass": true
    },
    "warmup_n": 5,
    "repeats": 1,
    "cooldown_s": 60,
    "soak_minutes": 0,
    "probes": {
      "interval_ms": 100,
      "tegrastats": "auto"
    },
    "output_dir": "results"
  }
}