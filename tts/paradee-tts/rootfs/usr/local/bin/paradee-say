#!/opt/venv/bin/python3
"""Paradee TTS to WAV. Usage: paradee-say "text" [-o out.wav] [--voice V] [--speed F]
Voices v1.0: af_heart only (bf_isabella/am_puck/bm_fable need v1.1+)."""
import argparse, os, wave

import numpy as np
from paradee import Paradee, SAMPLE_RATE


def main() -> None:
    ap = argparse.ArgumentParser(description="Paradee-8M TTS to WAV")
    ap.add_argument("text")
    ap.add_argument("-o", "--out", default="paradee.wav")
    ap.add_argument("--voice", default="af_heart")
    ap.add_argument("--speed", type=float, default=1.0)
    a = ap.parse_args()
    audio = Paradee(version=os.environ.get("PARADEE_MODEL_VERSION", "1.0"), quantized=True)(
        a.text, speed=a.speed, voice=a.voice
    )
    pcm = (np.clip(audio, -1, 1) * 32767).astype("<i2")
    with wave.open(a.out, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(SAMPLE_RATE)
        w.writeframes(pcm.tobytes())
    print(f"paradee: wrote {a.out} ({len(audio) / SAMPLE_RATE:.1f}s @ {SAMPLE_RATE} Hz)")


if __name__ == "__main__":
    main()
