#!/opt/venv/bin/python3
"""Chunked-streaming TTS HTTP server (stdlib only).

GET /say?text=...&voice=...   -> streamed WAV (header + raw PCM frames as
                                 generated; a slow reader back-pressures).
GET /health                  -> {"status": "ok"}

True streaming: tts.stream() yields float32 PCM chunks as they are generated
(TTFA ~28 ms CPU); frames are written to the socket as they arrive.
"""
import json
import os
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

from ptts import TTS

MODEL = os.environ.get("PTTS_MODEL", "/models/phonon-31m-en")
LANG = os.environ.get("PTTS_LANG", "en")
QUANT = os.environ.get("PTTS_QUANT", "q8")
PORT = int(os.environ.get("TTS_PORT", "8880"))

_tts: TTS | None = None
_tts_lock = threading.Lock()  # ptts instances are not documented thread-safe


def get_tts() -> TTS:
    global _tts
    with _tts_lock:
        if _tts is None:
            _tts = TTS(MODEL, lang=LANG, quant=QUANT)
        return _tts


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def _wav_header(self, n_frames: int, rate: int) -> bytes:
        buf = bytearray()
        buf += b"RIFF"
        buf += (36 + n_frames * 2).to_bytes(4, "little")
        buf += b"WAVE" + b"fmt "
        buf += (16).to_bytes(4, "little")
        buf += (1).to_bytes(2, "little")  # PCM
        buf += (1).to_bytes(2, "little")  # mono
        buf += rate.to_bytes(4, "little")
        buf += (rate * 2).to_bytes(4, "little")
        buf += (2).to_bytes(2, "little")
        buf += (16).to_bytes(2, "little")
        buf += b"data" + (n_frames * 2).to_bytes(4, "little")
        return bytes(buf)

    def do_GET(self) -> None:
        u = urlparse(self.path)
        if u.path == "/health":
            body = json.dumps({"status": "ok"}).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        if u.path != "/say":
            self.send_error(404)
            return
        q = parse_qs(u.query)
        text = (q.get("text") or [""])[0]
        voice = (q.get("voice") or [None])[0]
        if not text:
            self.send_error(400, "missing text")
            return
        self.send_response(200)
        self.send_header("Content-Type", "audio/wav")
        self.send_header("Transfer-Encoding", "chunked")
        self.end_headers()
        tts = get_tts()
        header_sent = False
        total = 0

        def write_chunk(data: bytes) -> None:
            self.wfile.write(hex(len(data))[2:].encode() + b"\r\n")
            self.wfile.write(data)
            self.wfile.write(b"\r\n")

        with _tts_lock, tts.stream(text) as audio:
            for pcm in audio:
                total += len(pcm)
                if not header_sent:
                    # streamed WAV: header with zero lengths, then raw frames
                    write_chunk(self._wav_header(0, audio.sample_rate))
                    header_sent = True
                write_chunk((pcm * 32767).astype("<i2").tobytes())
        self.wfile.write(b"0\r\n\r\n")

    def log_message(self, fmt: str, *args) -> None:  # quiet
        pass


if __name__ == "__main__":
    ThreadingHTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
